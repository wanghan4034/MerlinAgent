# ShadowsocksX (macOS) / SOCKS5 proxy settings for Mercari access in CN network
# Copy to .env and fill values.

# Required if you need outbound proxy from browser.
# Based on your ShadowsocksX screenshot: local SOCKS5 is 127.0.0.1:10808.
# In Docker, use host.docker.internal to access host-side proxy.
PROXY_SERVER=socks5://host.docker.internal:10808

# Optional auth (usually empty for local ShadowsocksX client)
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEISHU_WEBHOOK=

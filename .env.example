# Shadowsocks / SOCKS5 proxy settings for Mercari access in CN network
# Copy to .env and fill values.

# Required if you need outbound proxy from browser
PROXY_SERVER=socks5://host.docker.internal:1080

# Optional authentication
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FEISHU_WEBHOOK=
